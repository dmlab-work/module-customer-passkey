    <?php if ($block->isEnabled()): ?>
        <button type="button"
                class="btn btn-primary dmlab-customer-passkey-add"
                :disabled="busy"
                @click="add">
            <?= $escaper->escapeHtml(__('Add a passkey')) ?>
        </button>
    <?php endif; ?>
</div>
<?= $block->getChildHtml('webauthn') ?>
<script>
    function dmlabCustomerPasskeyManage() {
        'use strict';
        return {
            busy: false,
            message: '',
            reauth: false,
            config: {},
            texts: {},
            init() {
                const data = this.$el.dataset;
                this.config = JSON.parse(data.config || '{}');
                this.texts = {
                    unsupported: data.msgUnsupported,
                    failure: data.msgFailure,
                    rename: data.msgRename,
                    remove: data.msgDelete
                };
            },
            takePassword(body) {
                const field = this.$refs.password;
                if (field && field.value) {
                    body.password = field.value;
                }
                if (field) {
                    field.value = '';
                }
                return body;
            },
            askPassword(data) {
                this.reauth = true;
                this.message = data.message || this.texts.failure;
                this.$nextTick(() => this.$refs.password && this.$refs.password.focus());
            },
            needsReauth(result) {
                return result.status === 401 && result.data && result.data.reauth;
            },
            finish(result) {
                if (result.ok && result.data && result.data.success) {
                    window.location.reload();
                    return;
                }
                this.busy = false;
                this.message = (result.data && result.data.message) || this.texts.failure;
            },
            async add() {
                if (this.busy) {
                    return;
                }
                if (!window.PublicKeyCredential) {
                    this.message = this.texts.unsupported;
                    return;
                }
                const webauthn = window.dmlabPasskeyWebauthn;
                const body = this.takePassword({});
                this.busy = true;
                this.message = '';
                try {
                    const options = await webauthn.post(this.config.optionsUrl, this.config.formKey, body);
                    if (this.needsReauth(options)) {
                        this.busy = false;
                        this.askPassword(options.data);
                        return;
                    }
                    if (!options.ok || !options.data) {
                        this.finish(options);
                        return;
                    }
                    this.reauth = false;
                    const credential = await navigator.credentials.create({
                        publicKey: webauthn.creationOptions(options.data)
                    });
                    this.finish(await webauthn.post(this.config.verifyUrl, this.config.formKey, {
                        publicKeyCredential: JSON.stringify(webauthn.attestationPayload(credential))
                    }));
                } catch (e) {
                    this.finish({});
                }
            },
            async rename(event) {
                const button = event.currentTarget;
                if (this.busy) {
                    return;
                }
                const label = window.prompt(this.texts.rename, button.dataset.label || '');
                if (label === null) {
                    return;
                }
                this.busy = true;
                this.message = '';
                try {
                    this.finish(await window.dmlabPasskeyWebauthn.post(this.config.renameUrl, this.config.formKey, {
                        entity_id: button.dataset.entityId,
                        label: label
                    }));
                } catch (e) {
                    this.finish({});
                }
            },
            async remove(event) {
                const button = event.currentTarget;
                if (this.busy || !window.confirm(this.texts.remove)) {
                    return;
                }
                const body = this.takePassword({entity_id: button.dataset.entityId});
                this.busy = true;
                this.message = '';
                try {
                    const result = await window.dmlabPasskeyWebauthn.post(
                        this.config.deleteUrl,
                        this.config.formKey,
                        body
                    );
                    if (this.needsReauth(result)) {
                        this.busy = false;
                        this.askPassword(result.data);
                        return;
                    }
                    this.finish(result);
                } catch (e) {
                    this.finish({});
                }
            }
        };
    }
    window.addEventListener(
        'alpine:init',
        () => Alpine.data('dmlabCustomerPasskeyManage', dmlabCustomerPasskeyManage),
        {once: true}
    );
</script>
<?php if (isset($hyvaCsp)) { $hyvaCsp->registerInlineScript(); } ?>
