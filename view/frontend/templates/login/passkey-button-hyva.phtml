<?php if ($block->isAvailable()): ?>
    <?php $failure = __('Could not sign you in with a passkey. Please try again.'); ?>
    <div class="dmlab-customer-passkey col-span-full"
         x-data="dmlabCustomerPasskeyLogin"
         data-config="<?= $escaper->escapeHtmlAttr($block->getJsonConfig()) ?>"
         data-label-idle="<?= $escaper->escapeHtmlAttr($block->getButtonLabel()) ?>"
         data-label-busy="<?= $escaper->escapeHtmlAttr(__('Signing in…')) ?>"
         data-msg-unsupported="<?= $escaper->escapeHtmlAttr(__('Passkeys are not supported on this browser.')) ?>"
         data-msg-failure="<?= $escaper->escapeHtmlAttr($failure) ?>">
        <button type="button"
                class="btn btn-secondary dmlab-customer-passkey-button"
                :disabled="busy"
                @click="start">
            <span x-text="label"></span>
        </button>
        <div class="dmlab-customer-passkey-message" role="alert" x-show="message" x-text="message"></div>
    </div>
    <?= $block->getChildHtml('webauthn') ?>
    <script>
        function dmlabCustomerPasskeyLogin() {
            'use strict';
            return {
                busy: false,
                message: '',
                config: {},
                texts: {},
                init() {
                    const data = this.$el.dataset;
                    this.config = JSON.parse(data.config || '{}');
                    this.texts = {
                        idle: data.labelIdle,
                        busy: data.labelBusy,
                        unsupported: data.msgUnsupported,
                        failure: data.msgFailure
                    };
                },
                label() {
                    return this.busy ? this.texts.busy : this.texts.idle;
                },
                async start() {
                    if (this.busy) {
                        return;
                    }
                    if (!window.PublicKeyCredential) {
                        this.message = this.texts.unsupported;
                        return;
                    }
                    const webauthn = window.dmlabPasskeyWebauthn;
                    this.busy = true;
                    this.message = '';
                    try {
                        const options = await webauthn.post(this.config.optionsUrl, this.config.formKey, {});
                        if (!options.ok || !options.data) {
                            throw new Error('options');
                        }
                        const assertion = await navigator.credentials.get({
                            publicKey: webauthn.requestOptions(options.data)
                        });
                        const verify = await webauthn.post(this.config.verifyUrl, this.config.formKey, {
                            publicKeyCredential: JSON.stringify(webauthn.assertionPayload(assertion))
                        });
                        if (!verify.ok || !verify.data || !verify.data.success) {
                            throw new Error('verify');
                        }
                        // Verify dropped mage-cache-sessid, so Hyvä refetches private content on reload.
                        window.location.reload();
                    } catch (e) {
                        this.busy = false;
                        this.message = this.texts.failure;
                    }
                }
            };
        }
        window.addEventListener(
            'alpine:init',
            () => Alpine.data('dmlabCustomerPasskeyLogin', dmlabCustomerPasskeyLogin),
            {once: true}
        );
    </script>
    <?php if (isset($hyvaCsp)) { $hyvaCsp->registerInlineScript(); } ?>
<?php endif; ?>
