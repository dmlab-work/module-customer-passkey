<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Hyvä redeclares customer.login.container, dropping children added by the base handle. -->
        <referenceContainer name="customer.login.container">
            <block class="DmLab\CustomerPasskey\Block\Login\Passkey"
                   name="dmlab.customer.passkey.button"
                   before="customer_form_login"
                   template="DmLab_CustomerPasskey::login/passkey-button-hyva.phtml">
                <block class="Magento\Framework\View\Element\Template"
                       name="dmlab.customer.passkey.webauthn.hyva"
                       as="webauthn"
                       template="DmLab_CustomerPasskey::hyva/webauthn.phtml"/>
            </block>
        </referenceContainer>
    </body>
</page>
